# Frontend (Safe Public Variables Only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_ENV=development
# Optional: set to "true" to force local development sandbox mode even when Supabase URL is configured
VITE_USE_DEV_SANDBOX=false

# Server-side Supabase Edge Function Secrets (NEVER prefix with VITE_)
# Configure these in Supabase Secrets (`supabase secrets set ...`) or supabase/.env
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL_DIALOGUE=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_AUDIO=gemini-2.5-flash
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
MEDIA_SIGNING_TTL_SECONDS=120
PURGE_CRON_SECRET=replace-with-random-secret
